# act runner image. `runner-latest` mirrors the GitHub-hosted Actions runner
# (Node bundled, rustup preinstalled, common tools). The smaller `act-latest`
# image is missing Node from $PATH, which breaks JavaScript actions like
# Swatinem/rust-cache. See https://github.com/nektos/act/issues/107.
-P ubuntu-latest=catthehacker/ubuntu:runner-latest

# Force linux/amd64 so the catthehacker images work on Apple Silicon hosts.
# Slower than native arm64 (qemu emulation), but matches what runs on GitHub.
--container-architecture linux/amd64

# Don't try to run jobs that can't work locally (Windows/macOS runners).
--platform windows-latest=-self-hosted
--platform macos-latest=-self-hosted
